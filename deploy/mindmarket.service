# deploy/mindmarket.service — REFERENCE COPY of the EC2 boot unit.
#
# ⚠️ RECONSTRUCTED (2026-07-01) from the documented behavior of the live unit
# (installed on the box 2026-06-20, reboot-verified 2026-06-23 — see
# docs/aws/ci-image-deploy.md "Boot behavior"). The live file at
# /etc/systemd/system/mindmarket.service is the source of truth; it exists
# ONLY on the box. On the next SSH session run:
#     sudo cat /etc/systemd/system/mindmarket.service
# diff it against this file, and commit the verbatim copy. Fields most likely
# to differ from this reconstruction: User=/Group=, absolute binary paths,
# timeouts.
#
# ⚠️ With no User= set, systemd runs this as ROOT — so on a rebuilt box the
# GHCR login must exist for root too (`sudo docker login ghcr.io …`, the GHCR
# images are private) and git needs
# `sudo git config --system --add safe.directory <repo path>` or the
# root-run reset silently no-ops. Both steps are in
# docs/aws/instance-rebuild.md.
#
# WHY this is in git: instance loss previously meant re-deriving the unit from
# session-log prose (hours). With this file + docs/aws/instance-rebuild.md a
# replacement box is a checklist, not archaeology.
#
# Design invariants (do NOT "fix" these):
#   * PULL-ONLY, --no-build everywhere — an on-box build OOMs the t3.micro
#     (two prior outages). docker's own `restart: unless-stopped` is the
#     fallback if a boot-time pull fails.
#   * NEVER --remove-orphans — backend/frontend (compose.split.yml) and caddy
#     (compose.aws.yml) share one project; each file sees the other's
#     services as orphans.
#   * ExecStartPre `git reset --hard origin/main` — self-heals the working
#     tree (Caddyfile, compose files, assets/) on every boot, which is also
#     why a bad COMMITTED Caddyfile is an outage (guarded by ci.yml
#     validate-config).

[Unit]
Description=MindMarket split stack (pull-only; never builds on the box)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ec2-user/PersonalFinancialRiskManagement

# Self-heal the tree to origin/main (tolerate a network blip).
ExecStartPre=-/usr/bin/git fetch --quiet origin main
ExecStartPre=-/usr/bin/git reset --quiet --hard origin/main

# Pull fresh app images (best-effort — the leading '-' means a GHCR outage
# must not block boot; existing local images are used instead).
ExecStart=-/usr/bin/docker compose -f compose.split.yml pull --quiet backend frontend

# App services (never build, never touch other-file services).
ExecStart=/usr/bin/docker compose -f compose.split.yml up -d --no-build --no-deps backend frontend

# Ingress (caddy) from its canonical compose file.
ExecStart=/usr/bin/docker compose -f compose.aws.yml up -d --no-build

TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target

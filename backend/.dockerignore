# ⚠️ NOT APPLIED TO IMAGE BUILDS — documentation only.
# The backend image builds with context = repo ROOT (`context: .` in
# compose.split.yml and build-images.yml), and Docker only reads the
# .dockerignore at the CONTEXT ROOT — i.e. the top-level /.dockerignore,
# which now carries all of these exclusions. BuildKit would honor a
# `backend/Dockerfile.dockerignore`, but never this file. Edit the ROOT
# .dockerignore instead.

# VCS + tooling
.git
.gitignore
.gitattributes
.github

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.venv
venv
env

# Test + dev artifacts
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage
.coverage.*
coverage.xml
.cache

# Frontend (the backend image must never touch frontend code)
frontend
node_modules

# Streamlit-only artifacts
.streamlit/secrets.toml
.streamlit/secrets.toml.bak

# Local-only secrets (never in image)
.env
.env.local
.env.*.local
*.pem
*.key

# Docker / compose artifacts
Dockerfile
docker-compose.yml
compose.aws.yml
compose.split.yml

# Editor / OS
.idea
.vscode
.DS_Store

# Big data we don't want baked in
.cache/market_data
data/raw
data/cache
docs/screenshots
docs/marketing

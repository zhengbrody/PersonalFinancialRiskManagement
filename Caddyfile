# Caddyfile — CANONICAL live split-stack routing.
#
#   /api/v1/*   → backend  :8000   (FastAPI)
#   /_stcore/*  → app      :8501   (legacy Streamlit session keep-alive)
#   /legacy/*   → app      :8501   (legacy Streamlit workbench)
#   /           → frontend :3000   (Next.js)
#
# WHY this IS the canonical Caddyfile (not Caddyfile.split):
# `mindmarket.service` runs `git reset --hard origin/main` on every boot,
# wiping any local edit to this mounted file. So the split routing MUST
# live in git's `Caddyfile` — else a reboot reverts the whole site to the
# old Streamlit-only routing (2026-05-31 incident). The legacy container
# is service-named `app` (compose.aws.yml, which systemd brings up), hence
# `app:8501` not `streamlit:8501`. Pre-split rollback content lives in git
# history + EC2 Caddyfile.live.bak.
# TODO(B): once systemd moves to compose.split.yml + GHCR pulls, retarget
# the legacy routes to the `streamlit` service and drop this divergence.

{$SITE_HOST}, www.{$SITE_HOST} {
	# gzip compressible responses. NOTE: a prior attempt to exclude SSE via
	# `encode { match { not header Content-Type text/event-stream* } }` used
	# INVALID Caddyfile syntax — the `not` response matcher is unrecognized
	# even by caddy 2.11 — and crash-looped caddy on boot (parse error). The
	# Copilot SSE stream is fine without it: Cloudflare fronts the origin and
	# does edge compression, and browsers decode gzip transparently; the
	# stream still flushes. Keep this a plain directive so it always parses.
	encode gzip
	log {
		output stdout
		format json
	}

	# Redirect www → apex (unchanged from Caddyfile).
	@www host www.{$SITE_HOST}
	redir @www https://{$SITE_HOST}{uri} permanent

	# ── Brand + SEO static assets (unchanged from Caddyfile) ──────
	@brand_assets path /favicon.ico /favicon.png /favicon.svg /favicon-192.png /favicon-512.png /apple-touch-icon.png /site.webmanifest
	handle @brand_assets {
		root * /srv/brand
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle /robots.txt {
		root * /srv/seo
		file_server
	}

	handle /sitemap.xml {
		root * /srv/seo
		file_server
	}

	handle /googlecpW5HG50AaWNMEfTxdGBF6JxeviA-0QFaHDYS0xw_N8.html {
		header Content-Type "text/plain; charset=utf-8"
		respond "google-site-verification: googlecpW5HG50AaWNMEfTxdGBF6JxeviA-0QFaHDYS0xw_N8.html"
	}

	handle /about {
		root * /srv/seo
		rewrite * /about.html
		file_server
	}

	handle /demo {
		root * /srv/seo
		rewrite * /demo.html
		file_server
	}

	handle /sample-risk-report {
		root * /srv/seo
		rewrite * /sample-risk-report.html
		file_server
	}

	handle /portfolio-risk-management {
		root * /srv/seo
		rewrite * /portfolio-risk-management.html
		file_server
	}

	handle /ai-portfolio-analysis {
		root * /srv/seo
		rewrite * /ai-portfolio-analysis.html
		file_server
	}

	handle /portfolio-var-stress-testing {
		root * /srv/seo
		rewrite * /portfolio-var-stress-testing.html
		file_server
	}

	handle /personal-portfolio-risk-analysis {
		root * /srv/seo
		rewrite * /personal-portfolio-risk-analysis.html
		file_server
	}

	handle /margin-risk-calculator {
		root * /srv/seo
		rewrite * /margin-risk-calculator.html
		file_server
	}

	handle /portfolio-stress-test {
		root * /srv/seo
		rewrite * /portfolio-stress-test.html
		file_server
	}

	handle /stock-portfolio-concentration-risk {
		root * /srv/seo
		rewrite * /stock-portfolio-concentration-risk.html
		file_server
	}

	handle /robinhood-margin-risk {
		root * /srv/seo
		rewrite * /robinhood-margin-risk.html
		file_server
	}

	# ── /api/v1/* → FastAPI backend ───────────────────────────────
	# Caddy's reverse_proxy already sets X-Forwarded-* automatically;
	# uvicorn consumes them via the `--proxy-headers` CMD flag in
	# backend/Dockerfile. Backend endpoints are fast; default timeouts
	# (a few minutes) are more than enough.
	handle /api/v1/* {
		reverse_proxy backend:8000
	}

	# ── /legacy/* → Streamlit ──────────────────────────────────────
	# Strip the `/legacy` prefix on the way to Streamlit so internal
	# routing inside Streamlit stays unchanged. WebSocket + SSE
	# timeout matches the original Caddyfile.
	handle_path /legacy/* {
		reverse_proxy app:8501 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Bare `/legacy` (no trailing slash) → keep it sticky to Streamlit
	# so old bookmarks keep working without a redirect dance.
	handle /legacy {
		redir /legacy/ permanent
	}

	# ── /_stcore/* → Streamlit session keep-alive ─────────────────
	# Streamlit's WebSocket + session endpoints live at the ROOT path
	# (`/_stcore/stream`, `/_stcore/health`, `/_stcore/host-config`,
	# …), NOT under `/legacy/`. Before cutover `/` → Streamlit caught
	# these for free; now `/` → Next.js, so without this route an
	# active legacy session's WebSocket falls through to the frontend
	# catch-all and the page silently goes stale. Long timeouts mirror
	# the /legacy/* route.
	#
	# NOTE: on EC2 the live legacy container is service-named `app`
	# (it still runs from compose.aws.yml), so the deployed copy of
	# this file targets `app:8501`. In git we target `app:8501`
	# — the service name compose.split.yml actually defines. Keep both
	# in sync if the legacy container is ever renamed.
	handle /_stcore/* {
		reverse_proxy app:8501 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# ── / → Next.js frontend (default route) ──────────────────────
	# The catch-all `handle` MUST come last; matches everything not
	# pattern-matched above.
	handle {
		reverse_proxy frontend:3000
	}
}

# Bootstrap holding page when SITE_HOST is unset (first boot, before
# the deploy script writes .env). Same as live Caddyfile.
:80 {
	respond "MindMarket bootstrap pending" 503
}

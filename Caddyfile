# Caddyfile — CANONICAL live split-stack routing.
#
#   /api/v1/*   → backend  :8000   (FastAPI)
#   /           → frontend :3000   (Next.js)
#
# WHY the split routing lives in THIS exact file:
# `mindmarket.service` runs `git reset --hard origin/main` on every boot,
# wiping any local edit to this mounted file. So the split routing MUST
# live in git's `Caddyfile` — else a reboot reverts the routing (the
# 2026-05-31 incident). This is also why ci.yml's `validate-config` job
# runs `caddy validate` on every push: a bad COMMITTED Caddyfile is a
# guaranteed boot-time outage (2026-06-20 crash-loop). Pre-split rollback
# content and the former `Caddyfile.split` staging copy (removed
# 2026-07-01) live in git history.
#
# The legacy Streamlit workbench (/legacy/*, /_stcore/*) was RETIRED 2026-06-23:
# the `app` Streamlit container is gone, the backend no longer depends on
# Streamlit (requirements split), and those routes were removed. Any /legacy/*
# request now falls through to the Next.js catch-all (404). To bring Streamlit
# back, restore the routes + the `app` service from git history.

{$SITE_HOST}, www.{$SITE_HOST} {
	# Cloudflare Origin CA cert (15-year, expires 2041) — replaces Let's
	# Encrypt, killing the recurring ~60-day HTTP-01 renewal behind the proxy
	# (a silent renewal failure would darken the origin on a timer). The
	# cert/key live on the HOST at /srv/tls, mounted :ro by compose.aws.yml.
	# Only Cloudflare trusts this CA — fine, the SG only admits Cloudflare.
	# CI validates with a throwaway self-signed pair at the same paths
	# (ci.yml validate-config). ROLLBACK: delete this one line + recreate
	# caddy — the still-valid LE cert in the caddy_data volume resumes.
	tls /srv/tls/origin.pem /srv/tls/origin.key

	# gzip compressible responses. NOTE: a prior attempt to exclude SSE via
	# `encode { match { not header Content-Type text/event-stream* } }` used
	# INVALID Caddyfile syntax — the `not` response matcher is unrecognized
	# even by caddy 2.11 — and crash-looped caddy on boot (parse error). The
	# Copilot SSE stream is fine without it: Cloudflare fronts the origin and
	# does edge compression, and browsers decode gzip transparently; the
	# stream still flushes. Keep this a plain directive so it always parses.
	encode gzip
	log {
		output stdout
		# Signed share-card tokens are bearer URLs. Keep them out of the
		# CloudWatch access-log URI while retaining the route and query key.
		format filter {
			request>uri query {
				replace token REDACTED
			}
			wrap json
		}
	}

	# Redirect www → apex (unchanged from Caddyfile).
	@www host www.{$SITE_HOST}
	redir @www https://{$SITE_HOST}{uri} permanent

	# ── Security response headers ─────────────────────────────────
	# Stage 1: the CSP ships REPORT-ONLY — it observes (violations go to the
	# frontend Sentry project via report-uri) and blocks nothing, so a missed
	# origin can't break production. Enforce (rename to Content-Security-Policy)
	# only after the report stream runs quiet. Design notes:
	#   * script/style 'unsafe-inline': Next.js ships inline hydration/theme
	#     scripts and JSON-LD without nonces; a nonce scheme would defeat
	#     static caching — accepted trade-off, revisit post-report.
	#   * connect-src: Supabase (auth/REST), PostHog (events + remote config),
	#     Sentry ingest, and 'self' (covers the /api/v1/copilot SSE stream —
	#     same-origin EventSource/fetch, unaffected by these headers).
	#   * script-src hosts were derived from the Report-Only stream, not
	#     guessed: us-assets.i.posthog.com serves PostHog's runtime extension
	#     bundles as SCRIPTS (connect-src does not cover script loads — 507
	#     reports/58 users), and static.cloudflareinsights.com is the RUM
	#     beacon Cloudflare injects at the edge (169 reports/57 users).
	#     Enforcing without these would have silently killed analytics.
	#   * 'unsafe-eval' is deliberately ABSENT. The 417 `eval:` reports came
	#     from Zod v4's JIT validator compiler probing `new Function`; that is
	#     now disabled at source via `z.config({ jitless: true })`
	#     (frontend/src/lib/zod-config.ts), which is the correct fix — Zod
	#     falls back to interpreted validation under an enforcing policy
	#     anyway, so re-permitting eval would buy nothing and cost the main
	#     protection CSP exists for.
	#   * form-action includes accounts.google.com for the Supabase Google
	#     OAuth redirect; COOP is same-origin-allow-popups so any OAuth popup
	#     flow keeps its opener (full-page redirects are unaffected either way).
	#   * X-Frame-Options DENY + frame-ancestors 'none': nothing embeds us.
	#   * Fonts are self-hosted (/fonts/*, below) — font-src stays 'self'.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://us-assets.i.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://byfpmmfduteajblqpuuw.supabase.co wss://byfpmmfduteajblqpuuw.supabase.co https://us.i.posthog.com https://us-assets.i.posthog.com https://o4511493492178944.ingest.us.sentry.io; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'; report-uri https://o4511493492178944.ingest.us.sentry.io/api/4511494053560320/security/?sentry_key=c6ee4dd05a13fb3da4669a5a4db7ba08"
		-Server
	}

	# ── Brand + SEO static assets (unchanged from Caddyfile) ──────
	@brand_assets path /favicon.ico /favicon.png /favicon.svg /favicon-192.png /favicon-512.png /apple-touch-icon.png /site.webmanifest
	handle @brand_assets {
		root * /srv/brand
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Self-hosted fonts (assets/brand/fonts — replaced Google Fonts on the
	# static SEO pages so no font request leaves the origin).
	handle /fonts/* {
		root * /srv/brand
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# /robots.txt and /sitemap.xml are now served by Next.js (single SEO
	# source) — they fall through to the frontend catch-all below.

	handle /googlecpW5HG50AaWNMEfTxdGBF6JxeviA-0QFaHDYS0xw_N8.html {
		header Content-Type "text/plain; charset=utf-8"
		respond "google-site-verification: googlecpW5HG50AaWNMEfTxdGBF6JxeviA-0QFaHDYS0xw_N8.html"
	}

	# The former static SEO pages (about, demo, sample-risk-report,
	# portfolio-risk-management, ai-portfolio-analysis,
	# portfolio-var-stress-testing, personal-portfolio-risk-analysis,
	# margin-risk-calculator, portfolio-stress-test,
	# stock-portfolio-concentration-risk, robinhood-margin-risk) are now
	# Next.js routes — they fall through to the frontend catch-all below.
	# /demo is a permanent 301 → /demo-risk-check (handled in Next).

	# ── /api/v1/* → FastAPI backend ───────────────────────────────
	# Caddy's reverse_proxy already sets X-Forwarded-* automatically;
	# uvicorn consumes them via the `--proxy-headers` CMD flag in
	# backend/Dockerfile. Backend endpoints are fast; default timeouts
	# (a few minutes) are more than enough.
	handle /api/v1/* {
		reverse_proxy backend:8000
	}

	# ── / → Next.js frontend (default route) ──────────────────────
	# The catch-all `handle` MUST come last; matches everything not
	# pattern-matched above.
	handle {
		reverse_proxy frontend:3000
	}
}

# Bootstrap holding page when SITE_HOST is unset (first boot, before
# the deploy script writes .env). Same as live Caddyfile.
:80 {
	respond "MindMarket bootstrap pending" 503
}

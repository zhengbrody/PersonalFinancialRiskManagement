# Backend URL the browser bundle will call. Omit locally to default to
# http://localhost:8000. In production, an empty value means same-origin
# /api/v1 through Caddy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (optional in Phase 2 — the /score page is public and works
# without these). Required when protected routes land in Phase 3.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── E2E (Playwright) ──────────────────────────────────────────────────
# The default (mocked) E2E suite needs NO real env: playwright.config.ts injects
# dummy build-time NEXT_PUBLIC_* values and mocks every backend/Supabase/LLM call
# (see e2e/README.md). Optional override only:
#   E2E_PORT=3100   # port the test server builds + serves on
#
# The GATED real-auth smoke (npm run test:e2e:real) is opt-in and skips unless:
#   E2E_REAL_EMAIL=...       # a throwaway Supabase test user
#   E2E_REAL_PASSWORD=...
#   E2E_BASE_URL=https://mindmarket.app   # optional; defaults to production

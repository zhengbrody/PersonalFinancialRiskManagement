# Build context for the frontend image is `frontend/` only.

# Build / cache output (regenerated by `npm run build`)
.next
out
dist

# Deps (regenerated inside the image)
node_modules

# Test + dev artifacts
coverage
.vitest

# VCS
.git
.gitignore

# Local-only envs (anything with NEXT_PUBLIC_ that we DO want baked in
# is passed via --build-arg, not via .env.local)
.env
.env.local
.env.*.local

# Docker / compose artifacts
Dockerfile
.dockerignore

# Editor / OS
.idea
.vscode
.DS_Store

# Docs
README.md

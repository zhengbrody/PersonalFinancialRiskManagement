.git
.venv
**/.venv
__pycache__
**/__pycache__
*.pyc
.DS_Store
.cache
logs/
htmlcov/
.coverage
.pytest_cache
**/.pytest_cache
*.egg-info
build/
dist/

# CDK build artifacts — must be excluded or docker build (with repo root
# context) recurses into asset.<hash>/ folders that themselves contain a
# nested copy of repo, blowing up with ENAMETOOLONG.
infra/cdk.out/
infra/.venv/
**/cdk.out/

# Streamlit local secrets — never bake into a container image.
.streamlit/secrets.toml

# Phase 1 EC2 deploy detritus
docs/screenshots/

# Marketing/video source assets are not needed at runtime and can exceed the
# tiny EC2 instance's Docker build storage.
docs/marketing/youtube/audio/
docs/marketing/youtube/video/

# Editor / OS noise
.vscode/
.idea/
*.swp

# ── Backend image context guards ─────────────────────────────────────────
# The backend image builds with context = repo ROOT (compose.split.yml /
# build-images.yml), so THIS file is the only .dockerignore Docker applies.
# backend/.dockerignore is NOT read for that build (BuildKit would only honor
# a `backend/Dockerfile.dockerignore`). The backend imports engine/, domain/,
# libs/, agents/, backend/, and root *.py modules; nothing below is reachable
# at runtime, so excluding it only shrinks the image (`COPY . /app`).
# (assets/ + docs/ are served by Caddy from HOST bind mounts, never the image.)
frontend
.github
.claude
tests
backend/tests
supabase
exports
infra
docs
assets
**/node_modules
**/test-results

# Secrets — RECURSIVE patterns, so nested copies (e.g. infra/.env) can never
# bake into a locally-built image. CI checkouts are clean; local
# `docker compose build` uses the working tree, which is where these live.
# `**/.env*` deliberately covers the `cp .env .env.bak` habit too.
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/credentials.json
**/.npmrc
